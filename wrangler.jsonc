{
  "name": "asset-line-bot",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Who asked for the morning alert: one key per LINE userId, each expiring 3 days after it was written.
  "kv_namespaces": [{ "binding": "SUBSCRIBERS" }],
  // 01:00 UTC is 08:00 in Bangkok.
  "triggers": { "crons": ["0 1 * * *"] },
  "vars": {
    "API_URL": "https://asset-laravel.onrender.com",
    "APP_URL": "https://netiwitk.github.io/asset-scanner/",
    "LINE_API": "https://api.line.me"
  }
  // Secrets, set with `npx wrangler secret put <NAME>`: LINE_CHANNEL_SECRET, LINE_CHANNEL_ACCESS_TOKEN
}
